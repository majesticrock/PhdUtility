@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(
    Boost
    REQUIRED
    COMPONENTS
        serialization
        iostreams
)
find_dependency(Eigen3 REQUIRED)

include(
    "${CMAKE_CURRENT_LIST_DIR}/mrock_symbolic_operators-targets.cmake"
)

set(mrock_symbolic_operators_FOUND TRUE)